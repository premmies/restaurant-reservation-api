{
  "info": {
    "_postman_id": "59762f24-f086-4c6f-b9ac-bb8c039948e3",
    "name": "Restaurant API - Admin Requirements 7 to 9",
    "description": "Self-contained Postman collection for testing Admin Requirements 7-9. Creates a disposable regular user and reservation, logs in as Admin (set adminEmail and adminPassword in Collection Variables), views all/single reservations, edits the user's reservation, deletes it, and verifies deletion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "43210655"
  },
  "item": [
    {
      "name": "Setup - Create Target User & Reservation",
      "item": [
        {
          "name": "1. Register Target User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Target user registered successfully', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('userToken', data.token);",
                  "  const userObj = data.data || data.user || data;",
                  "  if (userObj._id) {",
                  "    pm.collectionVariables.set('targetUserId', String(userObj._id));",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Target User\",\n  \"tel\": \"0812345678\",\n  \"email\": \"target-{{$timestamp}}@example.com\",\n  \"password\": \"TestPassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "2. Get Target User ID (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fetched target user profile and ID', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.data._id).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('targetUserId', String(data.data._id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3. Get Restaurant ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Fetched available restaurant ID', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.data).to.be.an('array').that.is.not.empty;",
                  "  const firstId = data.data[0]._id || data.data[0].id;",
                  "  pm.expect(firstId).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('restaurantId', String(firstId));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. Create Target Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created disposable reservation owned by target user', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.data._id).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('adminReservationId', String(data.data._id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationDate\": \"2026-12-01\",\n  \"tables\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "reservations"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Tests - Requirements 7 to 9",
      "item": [
        {
          "name": "5. Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin can log in', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('adminToken', data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "6. Get Admin ID (/auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified admin role and saved adminUserId', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.data.role).to.eql('admin');",
                  "  pm.collectionVariables.set('adminUserId', String(data.data._id));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "7. View All Reservations (Req 7)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Requirement 7: admin can view reservations across users', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.data).to.be.an('array');",
                  "  const targetId = pm.collectionVariables.get('adminReservationId');",
                  "  pm.expect(data.data.some(item => String(item._id) === targetId)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "8. View Single Reservation Owned by Other User (Req 7)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Requirement 7: admin can view a reservation owned by another user', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(String(data.data._id)).to.eql(pm.collectionVariables.get('adminReservationId'));",
                  "  const ownerId = String(data.data.user?._id || data.data.user);",
                  "  pm.expect(ownerId).to.eql(pm.collectionVariables.get('targetUserId'));",
                  "  pm.expect(ownerId).not.to.eql(pm.collectionVariables.get('adminUserId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{adminReservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{adminReservationId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "9. Edit Reservation Owned by Other User (Req 8)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Requirement 8: admin can edit a reservation owned by another user', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.success).to.eql(true);",
                  "  pm.expect(data.data.tables).to.eql(2);",
                  "  pm.expect(data.data.reservationDate).to.include('2026-12-03');",
                  "  const ownerId = String(data.data.user?._id || data.data.user);",
                  "  pm.expect(ownerId).to.eql(pm.collectionVariables.get('targetUserId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationDate\": \"2026-12-03\",\n  \"tables\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reservations/{{adminReservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{adminReservationId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "10. Delete Reservation Owned by Other User (Req 9)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Requirement 9: admin can delete a reservation owned by another user', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{adminReservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{adminReservationId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "11. Confirm Reservation Was Deleted (Req 9)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Requirement 9: admin-deleted reservation is no longer available', () => {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{adminReservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{adminReservationId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
