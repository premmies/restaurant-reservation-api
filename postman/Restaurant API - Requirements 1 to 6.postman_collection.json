                  "  pm.expect(data.data._id).to.eql(pm.collectionVariables.get('reservationId'));",
                  "  pm.expect(String(data.data.user)).to.eql(pm.collectionVariables.get('userId'));",
                  "});"
                ]
              }
            }
          ],
