                  "  pm.expect(data.data.tables).to.eql(2);",
                  "  pm.expect(data.data.reservationDate).to.include('2026-12-02');",
                  "  pm.expect(data.data._id).to.eql(pm.collectionVariables.get('reservationId'));",
                  "});"
                ]
              }
            }
          ],
