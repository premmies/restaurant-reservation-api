    {
      "name": "Query overall reservation metrics",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Admin can query overall reservation metrics', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(data.success).to.eql(true);",
              "  pm.expect(data.data.totalReservations).to.be.a('number');",
              "  pm.expect(data.data.reservationsPerDay).to.be.an('array');",
              "  pm.expect(data.data.peakBookingHours).to.be.an('array');",
              "  pm.expect(data.data.mostPopularRestaurants).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminToken}}",
              "type": "string"
            }
